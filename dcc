#!/usr/bin/env bash
# dcc: a thin wrapper around docker compose. Manages the agent container (agent) + docker sidecar per workspace.
# Usage is in `dcc help` and README.md; the spec is docs/architecture.md.
#
# The implementation is lib/*.sh (all looked up relative to DCC_CONFIG_DIR, same place as the compose files):
#   log.sh      output format (▸ / ! / ✓), running external commands and dumping them on failure
#   config.sh   reading .env, defaults, DCC_CONTAINER_ENV_*
#   cli.sh      arguments, workspace and project name, header and usage
#   creds.sh    resolving credential modules and checking drift
#   docker.sh   reads docker / compose state (changes nothing)
#   project.sh  changes the compose project (build / up / stop / down ...)
#   all.sh      across all workspaces
# The flow of execution is as in main. Only main at the end runs at top level; sourcing the file
# only loads function definitions (for tests).
set -euo pipefail

# Location of this repository. Not derived from $0 (dcc may be placed on PATH as a symlink / copy)
CONFIG_DIR="${DCC_CONFIG_DIR:-$HOME/.config/dcc}"
CONFIG_DIR="$(cd "$CONFIG_DIR" && pwd)"
export DCC_CONFIG_DIR="$CONFIG_DIR"
# shellcheck source=lib/log.sh
. "$CONFIG_DIR/lib/log.sh"
# shellcheck source=lib/config.sh
. "$CONFIG_DIR/lib/config.sh"
# shellcheck source=lib/cli.sh
. "$CONFIG_DIR/lib/cli.sh"
# shellcheck source=lib/creds.sh
. "$CONFIG_DIR/lib/creds.sh"
# shellcheck source=lib/docker.sh
. "$CONFIG_DIR/lib/docker.sh"
# shellcheck source=lib/project.sh
. "$CONFIG_DIR/lib/project.sh"
# shellcheck source=lib/all.sh
. "$CONFIG_DIR/lib/all.sh"

main() {
  load_config
  parse_args "$@"
  resolve_workspace
  set -- "${ARGS[@]+"${ARGS[@]}"}"

  # Without flags, these commands inherit the existing container's selection (--adopt). Others don't use the selection
  case "$COMMAND" in
    default|exec|up|recreate|creds) resolve_creds --adopt ;;
    *) resolve_creds ;;
  esac

  case "$COMMAND" in
    default|exec|up|recreate|build) print_header ;;
  esac

  case "$COMMAND" in
    default|exec)
      up_container
      warm_gpg
      exec_agent "$@"
      ;;
    up)
      up_container
      done_step ready "${SECONDS}s"
      ;;
    recreate)
      clear_containers
      up_container
      warm_gpg
      done_step ready "${SECONDS}s"
      ;;
    stop)
      if [ "$ALL" -eq 1 ]; then for_each_project stop_containers; else stop_containers; fi
      ;;
    clear|rm)
      if [ "$ALL" -eq 1 ]; then for_each_project -a clear_containers "$@"; else clear_containers "$@"; fi
      ;;
    build)
      build_image "$@"
      ;;
    creds)
      show_creds
      ;;
    gh-login)
      gh_login "$@"
      ;;
    list|ls)
      list_containers
      ;;
    inspect)
      inspect_containers
      ;;
    help|-h|--help)
      usage
      ;;
    *)
      echo "unknown command: $COMMAND" >&2
      usage >&2
      exit 2
      ;;
  esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
