# Connection settings for the ssh module. Bound ro to /etc/ssh/ssh_config.d/github.conf.
# Used only for connecting to GitHub. The key is placed in ./capabilities/ssh/data (gitignored)
# as id_ed25519, and in the container it is bound ro to ~/.ssh.
# Host keys are pinned by ./capabilities/ssh/known_hosts (/etc/ssh/ssh_known_hosts), so
# there is no first-connection confirmation prompt and nothing is written to ~/.ssh.
Host github.com
  User git
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
