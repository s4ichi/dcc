# Per-user settings for dcc / compose. All optional; unset means the default on the right-hand side is used.
#
# Usage: copy this file to .env (gitignored) and enable only the lines you need.
# At startup dcc reads ${DCC_CONFIG_DIR}/.env as bash (changeable with DCC_ENV_FILE)
# and exports it as environment variables. If the same variable is also in the shell, the shell wins.
# compose itself also reads the same .env (when the project directory is this repository).
# When used from the devcontainer CLI / VS Code, .env is not read, so export in the shell.
#
# Values are interpreted as bash assignments ($HOME and ~ are expanded; quote values containing spaces).

# --- Location ---------------------------------------------------------------
# Location of this repository. Only this one cannot be set from .env (decided before reading it)
#DCC_CONFIG_DIR=$HOME/.config/dcc
# env file to read (effective only in the shell)
#DCC_ENV_FILE=$DCC_CONFIG_DIR/.env
# Default workspace (normally $PWD; can be overridden by an argument)
#DCC_WORKSPACE=$PWD

# --- Agent ------------------------------------------------------------------
# Default for --agent. claude or codex (both are in the same container and can be chosen at each start)
#DCC_AGENT=claude
# Arguments dcc puts before the user's arguments when starting the agent. Whitespace separated; quotes are not interpreted.
# The codex default only turns off Codex's own sandbox (the container is the sandbox; docs/codex.md).
# Setting an empty string adds nothing (e.g. DCC_CODEX_ARGS=)
#DCC_CLAUDE_ARGS=
#DCC_CODEX_ARGS='-c sandbox_mode=danger-full-access -c check_for_update_on_startup=false'

# --- Credential modules -----------------------------------------------------
# Default for --creds. Comma separated: aws / claude / codex / gpg / ssh / gh
# (claude / codex = share the host's ~/.claude / ~/.codex rw. When omitted, starts from an empty volume unrelated to the host)
#DCC_CREDS=

# 1 always streams compose / hook output (by default everything is shown only on failure)
#DCC_VERBOSE=

# --- Personal settings (local/) ---------------------------------------------
# Files with fixed names in ${DCC_CONFIG_DIR}/local (gitignored) are used automatically.
# If you manage them with dotfiles, make local/ a symlink or change the location with DCC_LOCAL_DIR.
#
#   local/Dockerfile  : adds layers to the agent image. Starts with FROM dcc:base.
#                       If present, it is built in two stages: this repository's Dockerfile → base,
#                       then the personal Dockerfile on top → agent image (dcc build / dcc up build the base first).
#                       The COPY source is local/. Example:
#                         FROM dcc:base
#                         USER root
#                         RUN apt-get update && apt-get install -y ripgrep && rm -rf /var/lib/apt/lists/*
#                         USER agent
#   local/compose.yml : personal compose overlay. Merged after the credential overlays.
#                       Put binds and environment variables specific to your environment here. Example:
#                         services:
#                           agent:
#                             environment:
#                               MY_TOOL_MARKER: "1"
#                             volumes:
#                               - type: bind
#                                 source: ${HOME}/.gitconfig.local
#                                 target: /home/agent/.gitconfig.local
#                                 read_only: true
#DCC_LOCAL_DIR=$DCC_CONFIG_DIR/local
# Further overlays added on top of local/compose.yml (colon-separated absolute paths)
#DCC_COMPOSE_FILES=

# --- Container user / image -------------------------------------------------
# User name / uid / gid inside the container. On a Linux host where uid is not 1000, match DCC_UID.
# Changing them changes the image too, so also change DCC_IMAGE (the tag is shared by all workspaces)
#DCC_USER=agent
#DCC_UID=1000
#DCC_GID=$DCC_UID
#DCC_IMAGE=dcc:local
# Tag of the base image when local/Dockerfile is used. If changed, match FROM in local/Dockerfile too
# (when changing DCC_USER / DCC_UID, give this a different tag as well, together with DCC_IMAGE)
#DCC_BASE_IMAGE=dcc:base
# Image of the Docker sidecar. The only privileged container, so the default is pinned by digest
# (index digest from docker buildx imagetools inspect docker:<ver>-dind-rootless; docs/docker.md)
#DCC_DIND_IMAGE=docker:29.9.2-dind-rootless@sha256:ae083cc7de51e7a8e5a597f8fb774ca7914c408a95fc0f1477826a913479518a
# Go version installed in the agent image (build arg)
#DCC_GO_VERSION=1.26.3

# --- Agent container environment --------------------------------------------
# Time zone. If unset, the shell's TZ, otherwise UTC
#DCC_TZ=UTC
# DCC_CONTAINER_ENV_<NAME>=value is passed as environment variable NAME inside the container (fixed at
# container creation; change with dcc recreate). Other variables are not passed to the container. Example:
#DCC_CONTAINER_ENV_GOPRIVATE='github.com/<org>/*'
#DCC_CONTAINER_ENV_EDITOR=vim

# --- Always-mounted host-side paths -----------------------------------------
#DCC_GITCONFIG=$HOME/.gitconfig

# --- claude module ----------------------------------------------------------
# Host-side paths to share
#DCC_CLAUDE_DIR=$HOME/.claude
#DCC_CLAUDE_JSON=$HOME/.claude.json
# Name of the empty external volume that becomes ~/.claude when the module is disabled (shared by all workspaces; created by dcc)
#DCC_CLAUDE_HOME_VOLUME=dcc-claude-home

# --- codex module -----------------------------------------------------------
# Host-side path to share (whole directory, rw; auth.json = includes the host Codex token)
#DCC_CODEX_DIR=$HOME/.codex
# Name of the empty external volume that becomes ~/.codex when the module is disabled (shared by all workspaces; created by dcc)
#DCC_CODEX_HOME_VOLUME=dcc-codex-home

# --- aws module -------------------------------------------------------------
#DCC_AWS_DIR=$HOME/.aws
# region: DCC_AWS_REGION > AWS_REGION > AWS_DEFAULT_REGION > us-east-1
#DCC_AWS_REGION=
# profile: DCC_AWS_PROFILE > AWS_PROFILE > default
#DCC_AWS_PROFILE=
# Port of the credential endpoint (change it if it collides with an inner container's -p in the shared netns)
#DCC_AWS_CREDENTIALS_PORT=8080

# --- gpg module -------------------------------------------------------------
# Host GnuPG home (private-keys-v1.d is ro-bound from here into the sidecar)
#DCC_GNUPG_DIR=$HOME/.gnupg
# Signing key (fingerprint / keyid / email). If unset, git config user.signingkey
#DCC_GPG_SIGNING_KEY=
# Output directory of the host-side export (read ro by the sidecar and the agent container)
#DCC_GPG_EXPORT_DIR=$DCC_CONFIG_DIR/capabilities/gpg/gnupg-host
# Port of the signing API
#DCC_GPG_SIGNER_PORT=8081

# --- ssh module -------------------------------------------------------------
# Location of the container-only private key (ro-bound to ~/.ssh)
#DCC_SSH_DIR=$DCC_CONFIG_DIR/capabilities/ssh/data
# Directory with github.conf + known_hosts, bound ro to /etc/ssh/dcc (default: the GitHub ones tracked in the repository)
#DCC_SSH_CONF_DIR=$DCC_CONFIG_DIR/capabilities/ssh/conf

# --- gh module --------------------------------------------------------------
# Host that issues tokens (for GitHub Enterprise, its host name)
#DCC_GH_HOST=github.com
# External volume holding the gh-token sidecar's state (refresh token). Shared by all workspaces; written by dcc gh-login
#DCC_GH_HOME_VOLUME=dcc-gh-home
# Port of the access token endpoint
#DCC_GH_TOKEN_PORT=8082
