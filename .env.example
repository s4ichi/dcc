# dcc / compose の利用者ごとの設定。すべて任意で、未設定なら右辺の既定値で動く。
#
# 使い方: このファイルを .env にコピーして (gitignore 済み) 必要な行だけ有効にする。
# dcc は起動時に ${DCC_CONFIG_DIR}/.env を bash として読み (DCC_ENV_FILE で変更可)、
# 環境変数として export する。同じ変数がシェルにもあればシェル側が優先する。
# compose 自身も同じ .env を読む (project directory がこのリポジトリのとき)。
# devcontainer CLI / VS Code から使う場合は .env は読まれないので、シェルで export する。
#
# 値は bash の代入として解釈される ($HOME や ~ は展開される。空白を含む場合は引用符で囲む)。

# --- 場所 -------------------------------------------------------------------
# このリポジトリの場所。これだけは .env からは設定できない (読む前に決まる)
#DCC_CONFIG_DIR=$HOME/.config/dcc
# 読み込む env ファイル (シェルでのみ有効)
#DCC_ENV_FILE=$DCC_CONFIG_DIR/.env
# ワークスペースの既定 (通常は $PWD。引数で上書き可)
#DCC_WORKSPACE=$PWD

# --- エージェント -----------------------------------------------------------
# --agent の既定値。claude か codex (両方とも同じコンテナに入っており、起動のたびに選べる)
#DCC_AGENT=claude
# dcc がエージェントの起動時に、利用者の引数の前へ足す引数。空白区切りで、引用は解釈されない。
# codex の既定は Codex 自身の sandbox だけを外す (コンテナが sandbox。docs/codex.md)。
# 空文字を設定すると何も足さない (例: DCC_CODEX_ARGS=)
#DCC_CLAUDE_ARGS=
#DCC_CODEX_ARGS='-c sandbox_mode=danger-full-access -c check_for_update_on_startup=false'

# --- credential モジュール --------------------------------------------------
# --creds の既定値。カンマ区切りで aws / claude / codex / gpg / ssh / gh
# (claude / codex = ホストの ~/.claude / ~/.codex を rw 共有。外すと空の volume で始まり、ホストとは無関係になる)
#DCC_CREDS=

# 1 にすると compose / フックの出力を常に流す (既定では失敗時だけ全部出す)
#DCC_VERBOSE=

# --- 個人設定の置き場 (local/) --------------------------------------------------
# ${DCC_CONFIG_DIR}/local (gitignore 済み) に決まった名前のファイルを置くと自動で使われる。
# dotfiles で管理するなら local/ を symlink にするか、DCC_LOCAL_DIR で場所を変える。
#
#   local/Dockerfile  : 本体イメージにレイヤを足す。先頭は FROM dcc:base。
#                       あればこのリポジトリの Dockerfile → base、その上に個人 Dockerfile → 本体、
#                       の 2 段で build される (dcc build / dcc up が base を先に作る)。
#                       COPY の元は local/。例:
#                         FROM dcc:base
#                         USER root
#                         RUN apt-get update && apt-get install -y ripgrep && rm -rf /var/lib/apt/lists/*
#                         USER agent
#   local/compose.yml : 個人の compose overlay。credential overlay の後にマージされる。
#                       個人環境依存の bind や環境変数はここに書く。例:
#                         services:
#                           agent:
#                             environment:
#                               MY_TOOL_MARKER: "1"
#                             volumes:
#                               - type: bind
#                                 source: ${HOME}/.gitconfig.local
#                                 target: /home/agent/.gitconfig.local
#                                 read_only: true
#DCC_LOCAL_DIR=$DCC_CONFIG_DIR/local
# local/compose.yml に加えてさらに足す overlay (コロン区切りの絶対パス)
#DCC_COMPOSE_FILES=

# --- コンテナ内ユーザー / イメージ --------------------------------------------
# コンテナ内のユーザー名 / uid / gid。Linux ホストで uid が 1000 でない場合は DCC_UID を合わせる。
# 変えたらイメージも変わるので DCC_IMAGE も変えること (タグは全ワークスペースで共有される)
#DCC_USER=agent
#DCC_UID=1000
#DCC_GID=$DCC_UID
#DCC_IMAGE=dcc:local
# local/Dockerfile 使用時の base イメージのタグ。変えたら local/Dockerfile の FROM も合わせる
# (DCC_USER / DCC_UID を変える場合は DCC_IMAGE と共にこちらも別タグにする)
#DCC_BASE_IMAGE=dcc:base
# Docker sidecar のイメージ (バージョン固定など)
#DCC_DIND_IMAGE=docker:dind-rootless
# 本体イメージにインストールする Go のバージョン (build arg)
#DCC_GO_VERSION=1.26.3

# --- 本体コンテナの環境 ---------------------------------------------------------
# タイムゾーン。未設定ならシェルの TZ、それも無ければ UTC
#DCC_TZ=UTC
# DCC_CONTAINER_ENV_<NAME>=value は、コンテナ内の環境変数 NAME として渡る (コンテナ作成時に固定。
# 変更は dcc recreate)。それ以外の変数はコンテナには渡らない。例:
#DCC_CONTAINER_ENV_GOPRIVATE='github.com/<org>/*'
#DCC_CONTAINER_ENV_EDITOR=vim

# --- 常時マウントするホスト側パス ---------------------------------------------
#DCC_GITCONFIG=$HOME/.gitconfig

# --- claude モジュール --------------------------------------------------------------
# 共有するホスト側パス
#DCC_CLAUDE_DIR=$HOME/.claude
#DCC_CLAUDE_JSON=$HOME/.claude.json
# モジュール無効時に ~/.claude になる空の外部 volume の名前 (全ワークスペース共有。dcc が作る)
#DCC_CLAUDE_HOME_VOLUME=dcc-claude-home

# --- codex モジュール ---------------------------------------------------------------
# 共有するホスト側パス (ディレクトリごと rw。auth.json = ホストの Codex の token を含む)
#DCC_CODEX_DIR=$HOME/.codex
# モジュール無効時に ~/.codex になる空の外部 volume の名前 (全ワークスペース共有。dcc が作る)
#DCC_CODEX_HOME_VOLUME=dcc-codex-home

# --- aws モジュール --------------------------------------------------------------
#DCC_AWS_DIR=$HOME/.aws
# region: DCC_AWS_REGION > AWS_REGION > AWS_DEFAULT_REGION > us-east-1
#DCC_AWS_REGION=
# profile: DCC_AWS_PROFILE > AWS_PROFILE > default
#DCC_AWS_PROFILE=
# credential endpoint のポート (共有 netns 内で inner container の -p と衝突する場合に変える)
#DCC_AWS_CREDENTIALS_PORT=8080

# --- gpg モジュール --------------------------------------------------------------
# ホストの GnuPG ホーム (private-keys-v1.d をここから sidecar に ro bind)
#DCC_GNUPG_DIR=$HOME/.gnupg
# 署名鍵 (fingerprint / keyid / email)。未設定なら git config user.signingkey
#DCC_GPG_SIGNING_KEY=
# ホスト側 export の出力先 (sidecar と本体が ro で読む)
#DCC_GPG_EXPORT_DIR=$DCC_CONFIG_DIR/capabilities/gpg/gnupg-host
# 署名 API のポート
#DCC_GPG_SIGNER_PORT=8081

# --- ssh モジュール --------------------------------------------------------------
# コンテナ専用の秘密鍵置き場 (~/.ssh に ro bind)
#DCC_SSH_DIR=$DCC_CONFIG_DIR/capabilities/ssh/data
# /etc/ssh に注入する接続設定とホスト鍵 (既定はリポジトリで追跡している GitHub 用)
#DCC_SSH_CONFIG=$DCC_CONFIG_DIR/capabilities/ssh/config
#DCC_SSH_KNOWN_HOSTS=$DCC_CONFIG_DIR/capabilities/ssh/known_hosts

# --- gh モジュール ---------------------------------------------------------------
# コンテナ専用の gh 設定 / token (~/.config/gh に rw bind)
#DCC_GH_DIR=$DCC_CONFIG_DIR/capabilities/gh/data
